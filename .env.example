# For the Docker Compose stack (docker compose --profile app up --build). Copy to .env, which
# git ignores, to use the real model. Without .env, the stack uses the simulated model.
# For pnpm dev, the settings live in apps/*/.env.local instead.

# The reference model (README, "Model, cost and limits") and your OpenAI key.
NEXO_AGENT_MODEL=openai/gpt-5.5
OPENAI_API_KEY=

# Usage limits (Stage 11). 0 turns a limit off.
NEXO_AGENT_TURNS_PER_DAY=40
NEXO_DAILY_BUDGET_USD=5
