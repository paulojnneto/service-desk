# Port of the simulated ticket service.
PORT=4000

# PostgreSQL started by `pnpm db:up` (Docker Compose). Required in production.
DATABASE_URL=postgres://nexo:nexo@localhost:55432/nexo_tickets

# Public key that checks the tokens signed by the API (base64 of a PEM).
# `pnpm bootstrap` writes it; the private key lives only in apps/api/.env.local.
TICKETS_JWT_PUBLIC_KEY=

# Simulated legacy instability (stage 4 PRD, S-04.15). Defaults: 600, 0.05 and 3.
# Set LEGACY_OUTAGE_RATE=0 and LEGACY_LATENCY_MS=0 to turn it off.
LEGACY_LATENCY_MS=600
LEGACY_OUTAGE_RATE=0.05
LEGACY_OUTAGE_SECONDS=3
