# Agent model, in the Mastra model router format (provider/model).
# "mock" (or empty) uses the simulated model, which needs no key.
# Examples: anthropic/claude-opus-5-5, anthropic/claude-haiku-5-5
NEXO_AGENT_MODEL=mock

# Provider key, only needed when NEXO_AGENT_MODEL points to a real model.
# Secrets live only here, never in apps/web.
ANTHROPIC_API_KEY=

# Port of the agent API.
PORT=3001

# Seals the session cookie (32+ characters). Required in production; without it,
# development uses a fixed secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL started by `pnpm db:up` (Docker Compose): conversations and sign-in sessions.
# Required in production.
DATABASE_URL=postgres://nexo:nexo@localhost:55432/nexo_api

# Ticket service, called by the agent from Stage 6.
TICKETS_URL=http://localhost:4000

# Private key that signs the tokens for the ticket service (base64 of a PEM).
# `pnpm bootstrap` writes it. Never commit it; the ticket service holds only the public key.
TICKETS_JWT_PRIVATE_KEY=
