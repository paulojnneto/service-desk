# Agent model, in the Mastra model router format (provider/model).
# "mock" (or empty) uses the simulated model, which needs no key.
# Reference: openai/gpt-5.5 (since Stage 6). The README explains the model choice and its cost.
NEXO_AGENT_MODEL=mock

# Provider key, only needed when NEXO_AGENT_MODEL points to a real model of that provider
# (for example ANTHROPIC_API_KEY for anthropic/...). Secrets live only here, never in apps/web.
OPENAI_API_KEY=

# Usage limits (Stage 11). 0 turns a limit off.
# Agent turns per employee per day (São Paulo time).
NEXO_AGENT_TURNS_PER_DAY=40
# Estimated cost of all agent turns per day, in US$.
NEXO_DAILY_BUDGET_USD=5

# 1 only behind a proxy that sets x-forwarded-for, so the per-address rate limit sees the
# caller's address (Stage 12).
TRUST_PROXY=

# Port of the agent API.
PORT=3001

# Seals the session cookie (32+ characters). Required in production; without it,
# development uses a fixed secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL started by `pnpm db:up` (Docker Compose): conversations and sign-in sessions.
# Required in production.
DATABASE_URL=postgres://nexo:nexo@localhost:55432/nexo_api

# Ticket service, read by the agent and written when the employee confirms a draft.
TICKETS_URL=http://localhost:4000

# Private key that signs the tokens for the ticket service (base64 of a PEM).
# `pnpm bootstrap` writes it. Never commit it; the ticket service holds only the public key.
TICKETS_JWT_PRIVATE_KEY=
