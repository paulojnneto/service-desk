{
  "name": "nexo-assist",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "bootstrap": "node scripts/dev-setup.mjs",
    "dev": "pnpm --parallel --filter @nexo/web --filter @nexo/api --filter @nexo/tickets dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @nexo/tickets db:migrate",
    "db:seed": "pnpm --filter @nexo/tickets db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.13.0",
    "jose": "6.2.12",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
