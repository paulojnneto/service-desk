{
  "name": "nexo-assist",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nexo/web --filter @nexo/tickets dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
